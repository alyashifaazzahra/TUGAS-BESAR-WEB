# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongodb:27017/tugas_besar_db

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=figure-images

# Ollama AI Kampus
OLLAMA_API_URL=https://ollama.if.unismuh.ac.id/api/generate
OLLAMA_MODEL=llama3

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:3000
