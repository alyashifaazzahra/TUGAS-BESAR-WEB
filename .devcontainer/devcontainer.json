{
  "name": "Tugas Besar Full-Stack",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    3000,
    5000,
    9000,
    9001,
    27017
  ],
  "portsAttributes": {
    "3000": {
      "label": "Frontend (Next.js)",
      "visibility": "public"
    },
    "5000": {
      "label": "Backend API",
      "visibility": "public"
    },
    "9000": {
      "label": "MinIO API",
      "visibility": "public"
    },
    "9001": {
      "label": "MinIO Console",
      "visibility": "public"
    }
  },
  "postCreateCommand": "cp -n backend/.env.example backend/.env; cp -n frontend/.env.example frontend/.env; echo 'Env files siap.'",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode",
        "42Crunch.vscode-openapi"
      ]
    }
  }
}